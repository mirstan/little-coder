.pi/sessions/
.pi/auth.json

# Benchmark run artifacts
benchmarks/tb_runs/
benchmarks/harbor_runs/
benchmarks/results_*.json
benchmarks/results_*.json.tmp
benchmarks/full_polyglot_logs/
benchmarks/full_polyglot_logs*/
benchmarks/gaia_logs/
benchmarks/gaia_runs/
benchmarks/archived_contaminated_runs/
benchmarks/priming_test_logs*/
benchmarks/repro_logs/
